# Copier ce fichier vers .env et renseigner les vraies valeurs en local uniquement.
# Ne jamais committer de vraies clés/secrets.

# Base de données
DATABASE_URL=postgresql://user:password@localhost:5432/zen_knowledge

# Auth.js
AUTH_SECRET=changeme
AUTH_URL=http://localhost:3000

# Fournisseur LLM / embeddings
OPENAI_API_KEY=changeme
GROQ_API_KEY=changeme

# Stockage S3-compatible
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme
S3_BUCKET_NAME=zen-knowledge-documents

# n8n
N8N_WEBHOOK_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=changeme
