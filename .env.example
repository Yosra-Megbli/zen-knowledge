# Copier ce fichier vers .env.local et renseigner les vraies valeurs en local uniquement.
# Ne jamais committer de vraies clés/secrets.
# Phase 3 : DATABASE, EMBEDDINGS et AUTH sont utilisées par le code.
# GROQ, SUPABASE et N8N restent préparées pour une phase ultérieure.

# ==================================================
# DATABASE (PostgreSQL + pgvector)
# ==================================================
# Connexion migration_role (superuser Docker local, POSTGRES_USER) —
# migrations, seed, maintenance contrôlée. Jamais utilisé au runtime.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=changeme
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# Mot de passe du rôle applicatif RLS-enforced app_role (créé par la
# migration 0002_roles.sql). Utilisé pour TOUTES les requêtes runtime.
APP_ROLE_PASSWORD=changeme

# ==================================================
# GROQ (LLM)
# ==================================================
GROQ_API_KEY=changeme
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b

# ==================================================
# EMBEDDINGS (locaux, CPU, aucun appel API externe)
# ==================================================
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DIMENSION=384

# Seuil de similarité minimum pour qu'un chunk autorisé soit considéré
# pertinent (mécanisme no-source). Calibré empiriquement sur le
# dataset de démo (dataset/, multilingual-e5-small) : le "bruit de
# fond" entre deux textes français de même domaine mais sans rapport
# (ex. une politique RH vs une recette de cuisine) mesure ~0.79-0.82
# de similarité cosinus avec ce modèle, alors qu'une correspondance
# réellement pertinente mesure ~0.86-0.91. Un seuil de 0.3 (valeur par
# défaut historique, jamais recalibrée) ne déclenche donc quasiment
# jamais le refus "aucune source" en pratique. 0.83 sépare correctement
# les deux plages sur ce dataset — à revérifier si le corpus réel
# change significativement de nature.
RAG_MIN_SIMILARITY=0.83

# ==================================================
# SUPABASE (déploiement/démonstration)
# ==================================================
SUPABASE_URL=changeme
SUPABASE_SERVICE_ROLE_KEY=changeme
SUPABASE_STORAGE_BUCKET=changeme

# Connexion directe Supabase (port 5432, pour migrations/seed)
# Settings → Database → Connection string → URI (mode Session)
SUPABASE_DIRECT_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Connexion poolée Supabase (port 6543, pour le runtime Next.js — app_role,
# JAMAIS postgres/migration_role ici, sinon RLS est contourné en production).
# Settings → Database → Connection string → URI (mode Transaction), en
# remplaçant le user "postgres" par "app_role" et le mot de passe par
# APP_ROLE_PASSWORD.
DATABASE_URL=postgresql://app_role.<project-ref>:<app_role-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ==================================================
# N8N (auto-hébergé, local via Docker)
# ==================================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_SECRET=changeme

# ==================================================
# AUTH (Auth.js)
# ==================================================
# Générer localement, ex. : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=changeme
AUTH_URL=http://localhost:3000
# Requis en local (hors Vercel) pour que Auth.js fasse confiance au host/port.
AUTH_TRUST_HOST=true

# ==================================================
# DEMO (Optionnel)
# ==================================================
# Mot de passe par défaut pour les comptes de démo de la page login (défaut: ZenDemo2026!).
# NEXT_PUBLIC_DEMO_PASSWORD=changeme
