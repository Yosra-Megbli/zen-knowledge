# Copier ce fichier vers .env.local et renseigner les vraies valeurs en local uniquement.
# Ne jamais committer de vraies clés/secrets.
# Phase 3 : DATABASE, EMBEDDINGS et AUTH sont utilisées par le code.
# GROQ, SUPABASE et N8N restent préparées pour une phase ultérieure.

# ==================================================
# DATABASE (PostgreSQL + pgvector)
# ==================================================
# Connexion migration_role (superuser Docker local, POSTGRES_USER) —
# migrations, seed, maintenance contrôlée. Jamais utilisé au runtime.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=changeme
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# Mot de passe du rôle applicatif RLS-enforced app_role (créé par la
# migration 0002_roles.sql). Utilisé pour TOUTES les requêtes runtime.
APP_ROLE_PASSWORD=changeme

# ==================================================
# GROQ (LLM)
# ==================================================
GROQ_API_KEY=changeme
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b

# ==================================================
# EMBEDDINGS (locaux, CPU, aucun appel API externe)
# ==================================================
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DIMENSION=384

# Seuil de similarité minimum pour qu'un chunk autorisé soit considéré
# pertinent (mécanisme no-source, Phase 3). Valeur conservatrice non
# calibrée — à ajuster une fois un jeu de données réel disponible.
RAG_MIN_SIMILARITY=0.3

# ==================================================
# SUPABASE (déploiement/démonstration)
# ==================================================
SUPABASE_URL=changeme
SUPABASE_SERVICE_ROLE_KEY=changeme
SUPABASE_STORAGE_BUCKET=changeme

# ==================================================
# N8N (auto-hébergé, local via Docker)
# ==================================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_SECRET=changeme

# ==================================================
# AUTH (Auth.js)
# ==================================================
# Générer localement, ex. : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=changeme
AUTH_URL=http://localhost:3000
# Requis en local (hors Vercel) pour que Auth.js fasse confiance au host/port.
AUTH_TRUST_HOST=true
