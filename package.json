{
  "name": "zen-knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZEN Knowledge — RAG interne multi-entreprises (test technique ZEN Group, Série F, F1)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:migrate": "node db/migrate.mjs",
    "db:reset": "node db/reset.mjs",
    "db:seed": "node db/seed.mjs",
    "db:seed-demo": "node --env-file-if-exists=.env.local scripts/seed-demo-dataset.mjs",
    "test:rls": "node --test tests/integration/rls/*.test.mjs",
    "test:embeddings": "node --env-file-if-exists=.env.local --test tests/unit/embeddings.test.ts",
    "test:auth": "node --env-file-if-exists=.env.local --test tests/unit/auth-callbacks.test.ts",
    "test:rag": "node --env-file-if-exists=.env.local --test tests/integration/rag/*.test.ts",
    "test:rag5": "node --env-file-if-exists=.env.local --test tests/unit/rag/*.test.ts tests/integration/rag/answer.test.ts",
    "test:auth-http": "node --test tests/integration/auth/http-flow.test.mjs",
    "test:ingestion": "node --env-file-if-exists=.env.local --test tests/unit/ingestion/*.test.ts tests/integration/ingestion/pipeline.test.ts tests/integration/ingestion/w3.test.ts",
    "test:phase3": "npm run test:rls && npm run test:embeddings && npm run test:auth && npm run test:rag",
    "test:phase5": "npm run test:rls && npm run test:ingestion && npm run test:rag5"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.45.0",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.4",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
